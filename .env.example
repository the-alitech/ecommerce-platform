# Database
POSTGRES_DB=ecom_earn
POSTGRES_USER=ecom_user
POSTGRES_PASSWORD=ecom_secret
DATABASE_URL=postgres://ecom_user:ecom_secret@db:5432/ecom_earn

# Django
SECRET_KEY=change-me-to-a-secure-random-string-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@ecom-earn.com
ADMIN_ORDER_EMAIL=admin@ecom-earn.com

# AWS S3 Compatible Storage
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=ecom-earn-media
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=us-east-1

# Site
SITE_NAME=H.B Shoes
SITE_URL=http://localhost:3000
API_URL=http://localhost:2000/api
WHATSAPP_NUMBER=923001234567

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:2000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3403.0!2d73.0!3d33.0!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMzPCsDAwJzAwLjAiTiA3M8KwMDAnMDAuMCJF!5e0!3m2!1sen!2s!4v1

# Redis (local dev: False; Docker: True with redis://redis:6379/0)
USE_REDIS=False
REDIS_URL=redis://127.0.0.1:6379/0
